# Non-secret configuration. Copy to .env only when overriding defaults.
OPENROUTER_AGENT_HOST=127.0.0.1
OPENROUTER_AGENT_PORT=3188
MAX_OUTPUT_TOKENS=8192
MAX_PROMPT_CHARS=400000
MAX_COMPARE_MODELS=4

# Weekly web-only public benchmark registry.
# HELIOS_BENCHMARK_CONFIG=/absolute/path/to/config/benchmark_sources.json
# HELIOS_STATE_DIR=/absolute/path/to/private/runtime/state

# macOS Keychain location used by scripts/configure-key.sh
OPENROUTER_KEYCHAIN_SERVICE=helios-multimodel-router
OPENROUTER_KEYCHAIN_ACCOUNT=openrouter-api-key

# Optional defense-in-depth for local HTTP calls. If set, configure the same
# value in the MCP process. Do not commit the value.
# HELIOS_LOCAL_API_KEY=

# Optional aliases. Exact OpenRouter slugs may also be sent per request.
DEFAULT_GLM_MODEL=z-ai/glm-5.2
# DEFAULT_GEMINI_MODEL=
# DEFAULT_GEMINI_FLASH_MODEL=
# DEFAULT_CLAUDE_MODEL=
# DEFAULT_DEEPSEEK_MODEL=
# DEFAULT_QWEN_MODEL=

# Non-macOS fallback only. Prefer a process secret store.
# OPENROUTER_API_KEY=
