{
  "schema_version": 1,
  "selection_policy": "public_web_benchmark_only",
  "search_model": "openrouter/auto",
  "search_engine": "exa",
  "max_results": 8,
  "max_output_tokens": 2500,
  "max_parallel": 3,
  "valid_days": 8,
  "min_ranked_models": 3,
  "exclude_domains": [
    "benchlm.ai",
    "reddit.com",
    "x.com",
    "twitter.com",
    "facebook.com",
    "instagram.com",
    "youtube.com",
    "tiktok.com"
  ],
  "task_aliases": {
    "analysis": "reasoning",
    "planning": "reasoning",
    "product": "reasoning",
    "backend": "coding",
    "software_engineering": "coding",
    "frontend_development": "frontend",
    "tool_use": "agentic_tool_use",
    "research": "web_research",
    "picture_analysis": "vision",
    "image_analysis": "vision",
    "text_generation": "reasoning",
    "diagram_generation": "image_generation"
  },
  "categories": {
    "reasoning": {
      "query": "latest public frontier AI reasoning model benchmark leaderboard",
      "benchmark_hints": ["GPQA Diamond", "ARC-AGI-2", "Humanity's Last Exam"],
      "allowed_domains": ["arcprize.org", "openai.com", "arxiv.org", "kaggle.com"]
    },
    "coding": {
      "query": "latest public coding and software engineering AI model benchmark leaderboard",
      "benchmark_hints": ["SWE-bench Verified", "LiveCodeBench"],
      "allowed_domains": ["swebench.com", "livecodebench.github.io", "openai.com"]
    },
    "frontend": {
      "query": "latest public frontend and web development AI model benchmark leaderboard",
      "benchmark_hints": ["WebDev Arena", "Design2Code"],
      "allowed_domains": ["arena.ai"]
    },
    "agentic_tool_use": {
      "query": "latest public AI agent tool-use benchmark leaderboard",
      "benchmark_hints": ["BFCL", "TAU-bench", "ToolBench"],
      "allowed_domains": ["gorilla.cs.berkeley.edu", "sky.cs.berkeley.edu", "proceedings.mlr.press"]
    },
    "web_research": {
      "query": "latest public AI web research and deep research benchmark leaderboard",
      "benchmark_hints": ["BrowseComp", "DeepResearch Bench", "GAIA"],
      "allowed_domains": ["openai.com", "deepresearch-bench.github.io", "xbench.org"]
    },
    "long_context": {
      "query": "latest public long-context language model benchmark leaderboard",
      "benchmark_hints": ["LongBench v2", "RULER"],
      "allowed_domains": ["longbench2.github.io", "arxiv.org", "aclanthology.org"]
    },
    "mathematics": {
      "query": "latest public mathematics reasoning AI model benchmark leaderboard",
      "benchmark_hints": ["AIME", "MATH-500"],
      "allowed_domains": ["matharena.ai", "artificialanalysis.ai"]
    },
    "vision": {
      "query": "latest public multimodal image understanding model benchmark leaderboard",
      "benchmark_hints": ["MMMU-Pro", "MMBench"],
      "allowed_domains": ["mmmu-benchmark.github.io", "artificialanalysis.ai"]
    },
    "ocr": {
      "query": "latest public OCR vision-language model benchmark leaderboard",
      "benchmark_hints": ["OCRBench v2", "OCRBench"],
      "allowed_domains": ["99franklin.github.io", "huggingface.co"]
    },
    "image_generation": {
      "query": "latest public text-to-image generation model leaderboard",
      "benchmark_hints": ["Artificial Analysis Image Arena", "GenAI-Bench"],
      "allowed_domains": ["arena.ai", "artificialanalysis.ai"]
    },
    "video_generation": {
      "query": "latest public AI text-to-video generation model leaderboard",
      "benchmark_hints": ["Artificial Analysis Video Arena", "VBench"],
      "allowed_domains": ["arena.ai", "artificialanalysis.ai"]
    },
    "multilingual": {
      "query": "latest public multilingual language model benchmark leaderboard including Persian",
      "benchmark_hints": ["Global-MMLU", "MMLU-ProX", "Persian language benchmark"],
      "allowed_domains": ["mmluprox.github.io", "cohere.com", "artificialanalysis.ai", "kaggle.com"]
    }
  }
}
