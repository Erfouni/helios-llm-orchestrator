{
  "schema_version": 1,
  "selection_policy": "public_web_benchmark_only",
  "search_model": "google/gemini-3.7-flash",
  "search_engine": "exa",
  "max_results": 12,
  "max_output_tokens": 3500,
  "max_parallel": 3,
  "valid_days": 8,
  "min_ranked_models": 3,
  "exclude_domains": [
    "benchlm.ai",
    "reddit.com",
    "x.com",
    "twitter.com",
    "facebook.com",
    "instagram.com",
    "youtube.com",
    "tiktok.com"
  ],
  "task_aliases": {
    "analysis": "reasoning",
    "planning": "reasoning",
    "product": "reasoning",
    "backend": "coding",
    "software_engineering": "coding",
    "frontend_development": "frontend",
    "tool_use": "agentic_tool_use",
    "research": "web_research",
    "picture_analysis": "vision",
    "image_analysis": "vision",
    "text_generation": "reasoning",
    "diagram_generation": "image_generation"
  },
  "categories": {
    "reasoning": {
      "query": "current ARC-AGI-2 verified frontier model leaderboard top model scores",
      "benchmark_hints": [
        "ARC-AGI-2 Verified Leaderboard"
      ],
      "allowed_domains": [
        "arcprize.org"
      ]
    },
    "coding": {
      "query": "current official SWE-bench Verified leaderboard top coding models",
      "benchmark_hints": [
        "SWE-bench Verified",
        "LiveCodeBench"
      ],
      "allowed_domains": [
        "swebench.com",
        "livecodebench.github.io",
        "artificialanalysis.ai"
      ]
    },
    "frontend": {
      "query": "current Code Arena WebDev Frontend leaderboard top models",
      "benchmark_hints": [
        "Code Arena WebDev Frontend"
      ],
      "allowed_domains": [
        "arena.ai"
      ]
    },
    "agentic_tool_use": {
      "query": "current Berkeley Function Calling Leaderboard BFCL V4 top models overall accuracy",
      "benchmark_hints": [
        "BFCL V4"
      ],
      "allowed_domains": [
        "gorilla.cs.berkeley.edu"
      ],
      "source_adapter": "official_csv",
      "benchmark_name": "Berkeley Function Calling Leaderboard (BFCL) V4",
      "data_url": "https://gorilla.cs.berkeley.edu/data_overall.csv",
      "source_url": "https://gorilla.cs.berkeley.edu/leaderboard.html",
      "rank_column": "Rank",
      "model_column": "Model",
      "score_column": "Overall Acc",
      "date_regex": "Last Updated:\\s*(\\d{4}-\\d{2}-\\d{2})",
      "notes": "Directly fetched from the official BFCL leaderboard CSV used by the UC Berkeley/Gorilla leaderboard page."
    },
    "web_research": {
      "query": "DeepResearch Bench leaderboard LLM with Search Tools top models by RACE overall score",
      "benchmark_hints": [
        "DeepResearch Bench RACE"
      ],
      "allowed_domains": [
        "deepresearch-bench.github.io"
      ]
    },
    "long_context": {
      "query": "latest public long-context language model benchmark leaderboard",
      "benchmark_hints": [
        "LongBench v2",
        "RULER"
      ],
      "allowed_domains": [
        "longbench2.github.io",
        "arxiv.org",
        "aclanthology.org"
      ]
    },
    "mathematics": {
      "query": "latest public mathematics reasoning AI model benchmark leaderboard",
      "benchmark_hints": [
        "AIME",
        "MATH-500"
      ],
      "allowed_domains": [
        "matharena.ai",
        "artificialanalysis.ai"
      ]
    },
    "vision": {
      "query": "latest public multimodal image understanding model benchmark leaderboard",
      "benchmark_hints": [
        "MMMU-Pro",
        "MMBench"
      ],
      "allowed_domains": [
        "mmmu-benchmark.github.io",
        "artificialanalysis.ai"
      ]
    },
    "ocr": {
      "query": "latest public OCR vision-language model benchmark leaderboard",
      "benchmark_hints": [
        "OCRBench v2",
        "OCRBench"
      ],
      "allowed_domains": [
        "99franklin.github.io",
        "huggingface.co"
      ]
    },
    "image_generation": {
      "query": "latest public text-to-image generation model leaderboard",
      "benchmark_hints": [
        "Artificial Analysis Image Arena",
        "GenAI-Bench"
      ],
      "allowed_domains": [
        "arena.ai",
        "artificialanalysis.ai"
      ]
    },
    "video_generation": {
      "query": "latest public AI text-to-video generation model leaderboard",
      "benchmark_hints": [
        "Artificial Analysis Video Arena",
        "VBench"
      ],
      "allowed_domains": [
        "arena.ai",
        "artificialanalysis.ai"
      ]
    },
    "multilingual": {
      "query": "current Global-MMLU-Lite multilingual benchmark leaderboard top models average across languages",
      "benchmark_hints": [
        "Global-MMLU-Lite"
      ],
      "allowed_domains": [
        "artificialanalysis.ai"
      ]
    }
  }
}
