[Unit]
Description=Helios OpenRouter Orchestrator with Durable Project Memory
Documentation=https://github.com/Erfouni/helios-llm-orchestrator
Wants=network-online.target
After=network-online.target aws-workload-credentials-provider-sm.service

[Service]
Type=simple
User=helios
Group=helios-runtime
SupplementaryGroups=aws-wcp-token
WorkingDirectory=/opt/helios/current
EnvironmentFile=/etc/helios/helios.env
Environment=PYTHONUNBUFFERED=1
Environment=AWS_REGION=eu-north-1
Environment=AWS_DEFAULT_REGION=eu-north-1
Environment=HELIOS_STATE_DIR=/var/lib/helios/runtime
LoadCredential=manus_api_key:/etc/credstore/helios.manus_api_key
StateDirectory=helios
StateDirectoryMode=0750
LogsDirectory=helios
LogsDirectoryMode=0750
UMask=0027
ExecStart=/usr/local/bin/helios-run
Restart=on-failure
RestartSec=5
TimeoutStartSec=60
TimeoutStopSec=30
KillSignal=SIGINT
StandardOutput=append:/var/log/helios/helios.log
StandardError=append:/var/log/helios/helios.log

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/helios
ReadWritePaths=/var/log/helios
ReadOnlyPaths=/var/run/awssmatoken
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
