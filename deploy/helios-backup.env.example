# Install as /etc/helios/backup.env. Never put credentials in this file.
HELIOS_DATA_DIR=/var/lib/helios
HELIOS_DATABASE_PATH=/var/lib/helios/helios.db
HELIOS_ARTIFACT_ROOT=/var/lib/helios/artifacts
HELIOS_STATE_DIR=/var/lib/helios/runtime
# Bind the actual canonical root here read-only using a systemd drop-in.
HELIOS_MEMORY_ROOT=/var/lib/helios/canonical-memory
HELIOS_BACKUP_REQUIRE_MEMORY=1
HELIOS_BACKUP_DIR=/var/lib/helios/backups
HELIOS_LOCAL_BACKUPS_TO_KEEP=14
# An external directory also needs a ReadWritePaths= systemd drop-in.
