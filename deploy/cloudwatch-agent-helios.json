{
  "agent": {
    "region": "eu-north-1"
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/helios/helios.log",
            "log_group_name": "/aws/helios/erfan-vps",
            "log_stream_name": "{instance_id}/helios",
            "retention_in_days": 30,
            "timezone": "UTC"
          }
        ]
      }
    }
  }
}
